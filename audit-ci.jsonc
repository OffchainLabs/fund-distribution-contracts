{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "low": true,
  "allowlist": [
    // cookie accepts cookie name, path, and domain with out of bounds characters
    "GHSA-pxg6-pf52-xh8x",
    // GovernorCompatibilityBravo may trim proposal calldata
    // We don't use governance
    "GHSA-93hq-5wgc-jc82",
    // OpenZeppelin Contracts vulnerable to Improper Escaping of Output
    // We don't use ERC2771Context
    "GHSA-g4vp-m682-qqmp",
    // OpenZeppelin Contracts using MerkleProof multiproofs may allow proving arbitrary leaves for specific trees
    // We don't use MerkleProof
    "GHSA-wprv-93r4-jj2p",
    // OpenZeppelin Contracts TransparentUpgradeableProxy clashing selector calls may not be delegated
    // We don't use TransparentUpgradeableProxy
    "GHSA-mx2q-35m2-x2rh",
    // OpenZeppelin Contracts's governor proposal creation may be blocked by frontrunning
    // We don't use governance
    "GHSA-5h3x-9wvq-w4m2",
    // OpenZeppelin Contracts base64 encoding may read from potentially dirty memory
    // We don't use base64
    "GHSA-9vx6-7xxf-x967",
    // OpenZeppelin Contracts's SignatureChecker may revert on invalid EIP-1271 signers
    // We don't use SignatureChecker
    "GHSA-4g63-c64m-25w9",
    // OpenZeppelin Contracts's GovernorVotesQuorumFraction updates to quorum may affect past defeated proposals
    // We don't use governance
    "GHSA-xrc4-737v-9q75",
    // OpenZeppelin Contracts's ERC165Checker may revert instead of returning false
    // We don't use ERC165Checker
    "GHSA-qh9x-gcfh-pcrw",
    // OpenZeppelin Contracts vulnerable to ECDSA signature malleability
    // We don't use ECDSA
    "GHSA-4h98-2769-gh6h",
    // OpenZeppelin Contracts ERC165Checker unbounded gas consumption
    // We don't use ERC165Checker
    "GHSA-7grf-83vw-6f5x",

    // ---------------------------------------------------------------------
    // Dev/build-tooling transitive advisories. These are NOT shipped: the
    // package's runtime `dependencies` is empty and only /src + /out are
    // published. Each is allowlisted because multiple major versions of the
    // package are live in the dependency tree (so a single forced version
    // would break another consumer) or no patched version exists. The
    // cleanly-patchable transitive deps are pinned via `resolutions` in
    // package.json instead.
    // ---------------------------------------------------------------------
    // minimatch ReDoS (3.x/5.x/9.x all in tree: eslint, hardhat, nitro-contracts, ...)
    "GHSA-3ppc-4f35-3m26",
    "GHSA-7r86-cg39-jmmj",
    "GHSA-23c5-xmqv-rm74",
    // picomatch ReDoS / glob matching (2.x and 4.x both in tree)
    "GHSA-c2c7-rcm5-vvqj",
    "GHSA-3v7f-55p6-f55p",
    // ws DoS / uninitialized memory (ethers v5 pins 7.x, others use 8.x)
    "GHSA-96hv-2xvq-fx4p",
    "GHSA-58qx-3vcg-4xpx",
    // ajv ReDoS via $data option (6.x and 8.x both in tree)
    "GHSA-2g4f-4pwh-qvx6",
    // bn.js infinite loop (4.x and 5.x both in tree; crypto libs)
    "GHSA-378v-28hj-76wf",
    // brace-expansion DoS (1.x and 2.x both in tree)
    "GHSA-f886-m6hf-6m8v",
    // js-yaml prototype pollution / DoS (3.x and 4.x both in tree)
    "GHSA-mh29-5h37-fv8m",
    "GHSA-h67p-54hq-rp68",
    // uuid missing buffer bounds check (older majors required by CJS consumers)
    "GHSA-w5hq-g745-h8pq",
    // yaml stack overflow (1.x via nitro-contracts; 2.x elsewhere)
    "GHSA-48c2-rrv3-qjmp",
    // jsdiff DoS (4.x/5.x/7.x in tree via ts-node, mocha, hardhat)
    "GHSA-73rr-hh4g-fpgx",
    // elliptic risky crypto primitive — no patched version exists (patched: <0.0.0)
    "GHSA-848j-6mx2-7j84"
  ]
}
